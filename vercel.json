{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend",
  "functions": {
    "api/server.js": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/server" },
    { "source": "/api/:path*", "destination": "/api/server" }
  ]
}
